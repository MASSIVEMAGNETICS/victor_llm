# --- NEW: LIGHTWEIGHT, ZERO-DEPENDENCY NLP ENGINE ---
class LightweightNLP:
    def __init__(self):
        self.stopwords = set(['the','a','an','is','it','and','or','to','of','in','for','on','with','at','by','from','as','that','this','these','those','be','have','has','was','were','are'])
        self.sentiment_lexicon = {
            'love': 2, 'like': 1, 'joy': 2, 'happy': 2, 'good': 1, 'great': 2, 'excellent': 2, 'strong': 1, 'success': 2,
            'hate': -2, 'bad': -1, 'pain': -2, 'angry': -2, 'sad': -2, 'shit': -1, 'fuck': -2, 'terrible': -2, 'weak': -1,
            'warning': -1, 'error': -1, 'failure': -2
        }
    
    def nlp_understand(self, text):
        """Performs NLP tasks using only standard libraries."""
        if not isinstance(text, str):
            text = str(text)
        
        lower_text = text.lower()
        
        # 1. Tokenize and filter stopwords
        tokens = re.findall(r'\b\w+\b', lower_text)
        filtered_tokens = [token for token in tokens if token not in self.stopwords]
        
        # 2. Sentiment analysis
        sentiment_score = sum(self.sentiment_lexicon.get(token, 0) for token in filtered_tokens)
        
        # 3. Keyword extraction (most common non-stopwords)
        keywords = [word for word, count in collections.Counter(filtered_tokens).most_common(5)]
        
        # 4. Intent detection
        intent = "question" if '?' in text or any(text.startswith(q) for q in ['what','who','why','how','when']) else "statement"
        
        return {
            "intent": intent,
            "sentiment": sentiment_score,
            "keywords": keywords
        }

# --- AGI VOCAL CORDS: BARK INFINITY UNIVERSAL ADAPTER (Unchanged) ---
class BarkInfinityAdapter:
    def __init__(self, mode='cli', voice_preset='bando', script_path='bark-infinity/generate.py'):
        self.mode = mode; self.default_voice = voice_preset; self.script_path = script_path
        self.output_dir = "victor_audio_output"
        if not os.path.exists(self.output_dir): os.makedirs(self.output_dir)

    def speak(self, text, voice=None):
        voice_preset = voice or self.default_voice
        output_filename = os.path.join(self.output_dir, f"victor_{uuid.uuid4().hex[:8]}.wav")
        print(f"[Victor Voice Synthesis] Generating audio...")
        try:
            self._synthesize_via_cli(text, voice_preset, output_filename)
            print(f"Audio saved as {output_filename}")
            if sa and os.path.exists(output_filename) and os.path.getsize(output_filename) > 0:
                wave_obj = sa.WaveObject.from_wave_file(output_filename); wave_obj.play().wait_done()
        except Exception as e:
            print(f"FATAL BARK INFINITY ERROR: {e}")
            if isinstance(e, FileNotFoundError): print("Please ensure bark-infinity is cloned and the script path is correct.")

    def _synthesize_via_cli(self, text, voice, output_path):
        if not os.path.exists(self.script_path):
            print(f"SIMULATION: Bark CLI script not found at '{self.script_path}'. Simulating audio.")
            with open(output_path, 'w') as f: pass # Create empty file to prevent playback errors
            return
        cmd = [sys.executable, self.script_path, "--text", text, "--voice", voice, "--output", output_path]
        subprocess.run(cmd, check=True, capture_output=True, text=True)


