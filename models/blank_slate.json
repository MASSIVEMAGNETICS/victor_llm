{
  "model_name": "Victor Blank Slate",
  "version": "1.0.0",
  "description": "Minimal untrained model configuration for Victor LLM system",
  "architecture": {
    "type": "transformer",
    "num_layers": 12,
    "hidden_size": 768,
    "num_attention_heads": 12,
    "intermediate_size": 3072,
    "max_position_embeddings": 2048,
    "vocab_size": 50257,
    "layer_norm_epsilon": 1e-05,
    "dropout_rate": 0.1,
    "attention_dropout": 0.1,
    "activation_function": "gelu"
  },
  "tokenizer": {
    "type": "BandoFractalTokenizer",
    "vocab_size": 50257,
    "max_length": 2048,
    "padding_side": "right",
    "truncation": true,
    "special_tokens": {
      "bos_token": "<|startoftext|>",
      "eos_token": "<|endoftext|>",
      "unk_token": "<|unknown|>",
      "pad_token": "<|pad|>",
      "mask_token": "<|mask|>"
    }
  },
  "training_config": {
    "optimizer": "adamw",
    "learning_rate": 5e-05,
    "weight_decay": 0.01,
    "beta1": 0.9,
    "beta2": 0.999,
    "epsilon": 1e-08,
    "batch_size": 8,
    "gradient_accumulation_steps": 4,
    "max_grad_norm": 1.0,
    "warmup_steps": 1000,
    "num_train_epochs": 3,
    "lr_scheduler": "cosine_with_warmup"
  },
  "initialization": {
    "method": "random_normal",
    "mean": 0.0,
    "std": 0.02,
    "seed": 42
  },
  "inference_config": {
    "max_new_tokens": 512,
    "temperature": 0.7,
    "top_p": 0.9,
    "top_k": 50,
    "repetition_penalty": 1.1,
    "do_sample": true,
    "num_beams": 1
  },
  "memory_config": {
    "use_hyperfractal_memory": true,
    "memory_capacity": 10000,
    "relevance_decay": 0.95,
    "emotional_impact_weight": 0.3
  },
  "sector_config": {
    "enable_cognitive_executive": true,
    "enable_prime_loyalty": true,
    "enable_plugin_system": true,
    "brain_fractal_pulse_exchange": {
      "buffer_size": 1000,
      "topic_subscriptions": [
        "input",
        "cognition",
        "memory",
        "output",
        "plugin",
        "loyalty"
      ]
    }
  },
  "metadata": {
    "created_date": "2025-11-02",
    "framework": "Victor Prime Synthesis Core",
    "compatible_versions": ["1.0.0+"],
    "license": "Proprietary - Massive Magnetics",
    "notes": "This is a blank slate configuration with random initialization. Train or fine-tune before production use."
  }
}
